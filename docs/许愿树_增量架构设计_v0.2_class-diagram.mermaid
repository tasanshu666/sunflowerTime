%% 🔴【v0.3.0 作废：孩子推送/可见性机制按玄参第 6 点作废，见 docs/许愿树_增量PRD_v0.3.md §1】
%% 许愿树 · 增量架构设计 v0.2 —— 类图（孩子自主推送 + 真机反馈修复）
%% 版本 v0.2.0 / 2026-11-18 / 高见远
%% 基线：v0.7.0（HEAD 7f19c61，schemaVersion 32 / wishes 22 列）
%% 本图相对 v0.1 类图的增量：Wishes 与 Wish 各 +1 列 sharedToParent（22→23）；
%%   Wish 新增只读判据 parentHasResponded；领域服务新增 shareWishToParent / withdrawShare；
%%   新增场景闸门 provider 与场景/按钮/弹层组件。旧图以 v0.1 文件保留，本图并存。
classDiagram
    class Wish {
        +String id
        +String childId
        +String text
        +WishCategory category
        +WishStatus status
        +DateTime createdAt
        +DateTime? committedAt
        +DateTime? commitDueDate
        +DateTime? fulfilledAt
        +String? fulfillSource
        +DateTime? abandonedAt
        +DateTime? parentSeenAt
        +DateTime? remindedAt
        +String? parentReply
        +String? replacedText
        +int? treeSlot
        +WishGoalMode targetMode
        +int targetValue
        +int progressValue
        +String? tagKey
        +DateTime? taggedAt
        +DateTime? releasedAt
        +bool sharedToParent «NEW · 23rd»
        +bool isMounted
        +bool isTagged
        +bool parentHasResponded «NEW · Q1 判据»
        +Wish copyWith(Object? sharedToParent)
    }

    class Wishes {
        <<Drift Table · schemaVersion 33>>
        +BoolColumn sharedToParent «NEW · DEFAULT 0»
        +IntColumn id
        +TextColumn childId
        +TextColumn text
        +IntColumn status
        +TextColumn? fulfillSource
        +TextColumn? tagKey
        +TextColumn? parentReply
        +DateTimeColumn? taggedAt
        +DateTimeColumn? releasedAt
    }

    class WishRepository {
        <<interface · 签名不变>>
        +Future~List~Wish~~ byStatuses(Set~WishStatus~ statuses)
        +Future~int~ countStampedAchieved() «NO visibility filter»
        +Future~Wish?~ byId(String id)
        +Future~void~ save(Wish wish)
    }

    class WishLocalRepository {
        -_toWish(row) Wish «+ sharedToParent»
        -_toCompanion(wish) Companion «+ sharedToParent»
        +Future~int~ countStampedAchieved() «unchanged»
    }

    class WishOrchestrationService {
        -WishRepository _wishes
        -_serialized(T Future) Future~T~
        +Future~List~Wish~~ parentDeskList(DateTime now) «+ where sharedToParent»
        +Future~int~ stampedAchievedCount() «unchanged»
        +Future~Wish~ shareWishToParent(String id, DateTime now) «NEW»
        +Future~void~ withdrawShare(String id) «NEW · guard parentHasResponded»
    }

    class wishTreeSceneActiveProvider {
        <<StateProvider~bool~>>
    }
    class wishShareRevisionProvider {
        <<StateProvider~int~>>
    }

    class WishTreePage {
        +initState() «scene = true»
        +dispose() «scene = false»
    }
    class GardenPage {
        -bool _ambientActive
        -Timer? _ambientTimer
        -_syncAmbientTimer() «paired start/stop»
        -_gardenVisible() bool «unchanged»
    }
    class WishShareAction {
        +Wish wish
        +bool canWithdraw
        +VoidCallback onShare
        +VoidCallback onWithdraw
    }
    class WishTagReplyResult {
        +WishTag? tag
        +String? reply
        +WishOccasion? occasion
    }
    class ParentWishActionSheet {
        +void Function(WishTagReplyResult?) onTagReply
        -_submitTagReply() «pop(result)»
        -_cancel() «pop() → null»
    }
    class ParentTodayPage {
        -_openTag(WishDeskEntry entry) «is-cast guard + try/catch»
        -_loadWishDesk() «parentDeskList + empty state»
    }

    Wish "1" -- "1" Wishes : mapped by
    WishRepository <|.. WishLocalRepository : implements
    WishOrchestrationService --> WishRepository : uses
    WishOrchestrationService ..> Wish : creates / updates
    WishTreePage ..> wishTreeSceneActiveProvider : flips
    WishTreePage ..> wishShareRevisionProvider : bumps
    GardenPage ..> wishTreeSceneActiveProvider : watches (ambient gate)
    WishTreePage --> WishShareAction : hosts
    WishShareAction ..> Wish : reads parentHasResponded
    ParentTodayPage --> ParentWishActionSheet : showDialog(barrierDismissible:false)
    ParentWishActionSheet ..> WishTagReplyResult : returns typed or null
    ParentTodayPage --> WishOrchestrationService : parentDeskList / withdraw
