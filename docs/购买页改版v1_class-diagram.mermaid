%% 购买页改版 v1 · 类图（Mermaid classDiagram）
%% 说明：橙色 = 本批新增；蓝色 = 本批修改；灰色 = 既有复用（不改）。
%% 纪律：PremiumUnlockTable 不得引用任何「权益命名空间」标识符（守卫白名单外），
%%       派生逻辑全部收口在 premium_gate.dart（已在 entitlement_gate_guard_test 白名单内）。

classDiagram
    %% ── 既有门控单点（不改）────────────────────────────
    class FeatureKey {
        <<enum>>
        oneClickCare
        gardenPotCapacity
        parentReport
        taskTemplateCount
        rewardTemplateCount
        multiChildProfile
        deepReport
        exportShare
        memoirExport
        familySharing
    }

    class FeatureRule {
        +FeatureKey key
        +bool freeEnabled
        +int freeQuota
        +bool premiumEnabled
        +int premiumQuota
        +isEnabledFor(EntitlementTier) bool
        +quotaFor(EntitlementTier) int
    }

    class EntitlementTier {
        <<enum>>
        free
        premium
    }

    class entitlement_matrix {
        <<library>>
        +int kUnlimitedQuota = -1
        +Map~FeatureKey,FeatureRule~ kEntitlementMatrix
        +featureAllowedFor(FeatureKey, EntitlementTier) bool
        +featureQuotaFor(FeatureKey, EntitlementTier) int
        +quotaAllowsAdd(FeatureKey, EntitlementTier, int) bool
    }

    %% ── 本批新增：presenter + 数据类（改 premium_gate.dart）──
    class PremiumUnlockRow {
        <<new>>
        +String label
        +String freeText
        +String premiumText
        +bool freeOk
        +bool premiumOk
        +FeatureKey key
    }

    class premium_gate {
        <<library · 已在守卫白名单>>
        +PremiumUnlockRow[] unlockRowsFor(matrix) 「新增·唯一presenter」
        -String _featureLabel(FeatureKey) 「既有·复用」
        +featureLabelFor(FeatureKey) String 「可选·暴露给对比表? 否」
    }

    %% ── 本批新增：对比表组件（守卫干净）──────────────
    class PremiumUnlockTable {
        <<new · StatelessWidget>>
        +bool isUnlocked
        +build(context) Widget
    }
    class _TableHeader {
        <<new · private>>
        +build() 免费版胶囊 / 解锁全部功能★金胶囊
    }
    class _GroupBand {
        <<new · private>>
        +String title  「免费就能用 / 买断后解锁」
    }
    class _UnlockRowView {
        <<new · private>>
        +String label
        +String freeText
        +String premiumText
        +bool freeOk
        +bool premiumOk
        +String? note  「如『扩容仍需花阳光（C70）』」
    }
    class _Cell {
        <<new · private>>
        +bool ok
        +String text
    }
    class _goldPill {
        <<new · private>>
        +String text
    }

    %% ── 本批修改：页面 ────────────────────────────────
    class ParentPremiumPage {
        <<modified · ConsumerStatefulWidget>>
        +bool _loading
        +bool _storeUnavailable
        +bool _buying
        +bool _restoring
        +IapProduct? _product
        +_loadProduct()
        +_buy()
        +_restore()
        +_buildBody(bool)  「顺序改：主卡→对比表→预览徽标→主按钮→恢复→说明」
        +_buildHeroCard(bool)  「升级：金渐变+描边+发光+徽章+金胶囊」
        +_buildPreviewBadges() 「新增：4 枚真实项徽标」
        +_buildMainButton(bool) 「升级：金渐变胶囊 + 立即解锁 · $price」
        +_buildRestoreButton() 「🔴 保留 Apple 硬性要求」
        +_buildNotesCard() 「🔴 保留 4 条诚实说明」
        +kPremiumMainButtonKey Key
        +kPremiumRestoreButtonKey Key
    }

    class ParentSettingsPage {
        <<modified>>
        +build() 「分区标题：会员与购买 → 解锁全部功能」
    }

    class PremiumStatusText {
        <<reused · 类名不改>>
        +build(context, ref) 已解锁/未解锁
    }

    class _PremiumSunflowerIcon {
        <<reused · 素材与尺寸逻辑不变>>
        +Color bg
        +double _size = 52
        +double _radius = 14
    }

    class cream_card {
        <<library · 复用>>
        +creamCardDecoration() BoxDecoration
        +macaronColorById(String) Map
        +pillLabel(text,bg,fg) Widget
    }

    class responsive {
        <<library · 复用>>
        +double uiScaleOf(BuildContext)
        +bool isTabletOf(BuildContext)
    }

    %% ── 关系 ──────────────────────────────────────────
    entitlement_matrix o-- FeatureRule : 收口
    FeatureRule --> FeatureKey : key
    FeatureRule --> EntitlementTier : isEnabledFor/quotaFor 入参

    premium_gate ..> entitlement_matrix : 读（featureAllowedFor / featureQuotaFor）
    premium_gate ..> PremiumUnlockRow : 构造并返回
    premium_gate --> FeatureKey : 显式枚举 4 键（禁 values 遍历）

    PremiumUnlockTable --> PremiumUnlockRow : 渲染 B 组
    PremiumUnlockTable *-- _TableHeader
    PremiumUnlockTable *-- _GroupBand
    PremiumUnlockTable *-- _UnlockRowView
    _UnlockRowView *-- _Cell
    _TableHeader *-- _goldPill
    PremiumUnlockTable ..> cream_card : 复用 pillLabel/creamCardDecoration
    PremiumUnlockTable ..> responsive : uiScaleOf（图形/行高）

    ParentPremiumPage --> PremiumUnlockTable : 嵌入（传 bool isUnlocked）
    ParentPremiumPage ..> premium_gate : unlockRowsFor()（预览徽标复用）
    ParentPremiumPage ..> entitlementProvider : 只读→ isPremium（页面已白名单）
    ParentPremiumPage *-- _PremiumSunflowerIcon
    ParentPremiumPage ..> responsive : uiScaleOf
    ParentSettingsPage ..> PremiumStatusText : 副标题
    ParentSettingsPage --> ParentPremiumPage : Push /parent/premium
