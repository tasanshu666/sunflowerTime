# 官网自动解锁方案 B · 配置样例
# 复制为 server/.env 后填入真实值。⚠️ .env 含密钥，禁止提交版本库、禁止放进 APK。
# 用法：set -a; source server/.env; set +a  然后启动 uvicorn

# ---------------------------------------------------------------------------
# 运行环境：sandbox（默认）| production
# 沙箱与生产的【支付宝公钥不同】，因此两套公钥必须分别配置，绝不共用。
# ---------------------------------------------------------------------------
APP_ENV=sandbox

# 网关由 APP_ENV 自动选择，一般不要手填；留空即使用对应环境的默认网关：
#   sandbox    -> https://openapi-sandbox.dl.alipaydev.com/gateway.do
#   production -> https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=

# 支付宝开放平台应用 ID（沙箱应用与生产应用通常是两个不同 APPID）
ALIPAY_APP_ID=

# 支付宝收款账号 PID（notify 的 seller_id 必须等于它）
ALIPAY_SELLER_ID=

# 应用私钥 RSA2（PKCS#8）。这是【支付宝】体系私钥，不是发码私钥！
# 二选一：直接写 PEM（把换行写成字面量 \n），或用下面的文件路径（推荐，文件权限 600）。
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_APP_PRIVATE_KEY_PATH=

# 支付宝公钥（用于验 notify 签名）——沙箱 / 生产分开填写，绝不混用
ALIPAY_SANDBOX_PUBLIC_KEY=
ALIPAY_PRODUCTION_PUBLIC_KEY=

# 支付宝异步通知地址，必须是公网 HTTPS
NOTIFY_URL=https://api.sunfocused.top/v1/alipay/notify

# ---------------------------------------------------------------------------
# 服务端本地配置
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/server.db

# 内部补发后台 token。留空时仅允许 127.0.0.1 / ::1 访问；公网部署务必设置。
ADMIN_TOKEN=

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# 下单后订单有效期（秒）。超时未付款的订单 redeem 返回 unpaid(200)。
ORDER_TTL_SECONDS=900

# 限流（内存字典，重启清零）
CREATE_RATE_WINDOW_SECONDS=600
CREATE_RATE_MAX=5
REDEEM_RATE_WINDOW_SECONDS=60
REDEEM_RATE_MAX=10

# 金额固定 29.90，服务端不接受客户端传值，也不允许通过环境变量修改。
# 见 app/config.py 的 AMOUNT 常量（字符串，绝不转 float）。
